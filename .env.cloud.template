# Cloud Agent Environment (Draft-Only)
# SECURITY: NEVER commit this file!
# Copy to cloud/.env.cloud or load from %USERPROFILE%\.ai_employee\secrets\
VAULT_PATH=/home/ubuntu/ai-employee-vault
CHECK_INTERVAL=30
SYNC_INTERVAL=300
AGENT_ROLE=cloud
AGENT_TYPE=draft_only
DRY_RUN=true

# Cloud endpoints
CLOUD_ENDPOINT=http://localhost:8081
LOCAL_ENDPOINT=http://localhost:8082

# Odoo Configuration
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USERNAME=admin
ODOO_API_KEY=

# Gmail API (Read-only for Cloud)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Git Configuration
GIT_REPO_URL=
GIT_SYNC_INTERVAL=300
